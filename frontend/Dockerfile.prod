FROM node:26.13.1-slim AS builder

# Set the working directory
WORKDIR /app

# Copy app dependencies
COPY package.json yarn.lock /app/

# Install yarn
RUN npm install --global yarn@1.22.22

# Install app dependencies
RUN yarn install

# Copy app source
COPY . /app

# Build app
ARG APP_VERSION
RUN export APP_VERSION="${APP_VERSION:-$(node -p "require('./package.json').version")}" \
    BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    && npm run build -- --output-path=./dist/out --configuration production \
      "--define=__APP_VERSION__=$(node -p 'JSON.stringify(process.env.APP_VERSION)')" \
      "--define=__BUILD_TIME__=$(node -p 'JSON.stringify(process.env.BUILD_TIME)')"

# Setup NGINX to serve the app
FROM nginx:1.31.9-alpine

# Copy the built app to the NGINX server
COPY --from=builder /app/dist/out/browser /usr/share/nginx/html

# Copy the NGINX configuration file
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# Expose port for the NGINX server
EXPOSE 4200
